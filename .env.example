# Copy to .env. Everything else has a default; see README.md.

# Your source: a Dispatcharr, or another Xtream Codes server. This add-on has to reach it,
# and so does every player, because this address goes into every stream URL. A name only
# Docker can resolve will not work.
XC_BASE_URL=https://xtream.example.com

# A user on that source. Use a dedicated one you can revoke. On Dispatcharr this is a
# user's name and XC password, which is set on the user and is not the web login password.
XC_USERNAME=changeme
XC_PASSWORD=changeme

# Converts the IMDb ids clients ask with into the TMDB ids Xtream Codes sources carry.
# Use your own, from the API section of your TMDB account settings. None is included.
# Set one of these: the v3 API key or the v4 read access token. Without either, IMDb
# ids only match a source that supplies them itself.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# Set this to 127.0.0.1 if the aggregator shares this container's network namespace, so
# that only something inside the namespace can read the credentials in stream responses.
# HOST=127.0.0.1

# The user the container runs as, which has to be able to write to ./data.
# PUID=1000
# PGID=1000
